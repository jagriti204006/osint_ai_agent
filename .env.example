# Copy to .env and fill in. .env is gitignored — never commit it.
#   cp .env.example .env
#
# Nothing here is required to start: the four no-key sources (LOLBAS,
# GTFOBins, RDAP/WHOIS, Cymru MHR) work with this file empty. Fill each
# key in as you get it and that source lights up.

# --- Core ---
VT_API_KEY=
ABUSEIPDB_API_KEY=
ABUSECH_AUTH_KEY=
URLSCAN_API_KEY=
OTX_API_KEY=
GREYNOISE_API_KEY=
GOOGLE_SAFEBROWSING_API_KEY=

# --- Optional, add later ---
IPINFO_TOKEN=
TRIAGE_API_KEY=
HYBRIDANALYSIS_API_KEY=

# --- Behaviour ---
# Cache TTL in seconds for source responses (protects your rate limits)
CACHE_TTL=3600
# Set true to allow file upload to public sandboxes. Leave false.
ALLOW_PUBLIC_FILE_UPLOAD=false
