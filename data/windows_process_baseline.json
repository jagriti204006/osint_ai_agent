      "orphaned": false,
      "expected_users": ["<varies>"],
      "instance_policy": "multiple",
      "syswow64_ok": false,
      "severity_if_mismatch": "high",
      "variable_parent": true,
      "notes": "Parent is whichever console process spawned it (cmd.exe, powershell.exe, ssh, a service), so parent alone proves little. A conhost.exe with NO console-app parent, or one spawned by a document-handling app, deserves a look.",
      "attack_techniques": ["T1036.005"]
    },
    {
      "name": "taskhostw.exe",
