{
  "schema_version": "1.0",
  "description": "Known-good baseline for legitimate Windows processes. Used to detect masquerading (MITRE T1036.005) by comparing an observed process against its expected path, parent, user context, and instance count.",
  "reference": "Modelled on the SANS 'Know Normal, Find Evil' methodology. Verify against your own gold image before trusting in production.",
  "path_variables": {
    "%SystemRoot%": "Typically C:\\Windows",
    "%SystemDrive%": "Typically C:",
    "%ProgramFiles%": "Typically C:\\Program Files"
  },
  "matching_rules": {
    "path": "Compare case-insensitively after expanding variables and normalising slashes. A correct name in a wrong directory is the single strongest masquerading signal.",
    "syswow64": "Processes with syswow64_ok=true also legitimately run from %SystemRoot%\\SysWOW64\\ on 64-bit Windows (32-bit variant).",
    "parent": "expected_parents lists normal parents. Where orphaned=true the real parent exits during boot, so an empty or stale parent is normal and must not be flagged.",
    "unknown_process": "A name absent from this baseline is NOT malicious by default - it is merely unknown. Fall back to hash reputation lookup.",
    "severity": "Use severity_if_mismatch to weight findings. critical entries are near-certain compromise indicators when the path does not match."
  },
  "instance_policies": {
    "singleton": "Exactly one instance system-wide. More than one is highly suspicious.",
    "one_per_session": "One instance per logon session.",
    "one_per_user": "One instance per interactive user.",
    "multiple": "Many concurrent instances are normal.",
    "transient": "Short-lived; often absent entirely."
  },

  "processes": [
    {
      "name": "System",
      "category": "core",
      "description": "Kernel and kernel-mode threads. Not a real image on disk.",
      "expected_paths": [],
      "path_on_disk": false,
      "expected_parents": [],
      "orphaned": true,
      "expected_users": ["NT AUTHORITY\\SYSTEM"],
      "instance_policy": "singleton",
      "expected_pid": 4,
      "expected_session": 0,
      "syswow64_ok": false,
      "severity_if_mismatch": "critical",
      "notes": "Always PID 4. Any 'System.exe' with a real file path is malware - the genuine System process has no image path.",
      "attack_techniques": ["T1036.005"]
    },
    {
      "name": "smss.exe",
      "category": "core",
      "description": "Session Manager Subsystem. First user-mode process; creates sessions.",
      "expected_paths": ["%SystemRoot%\\System32\\smss.exe"],
      "path_on_disk": true,
      "expected_parents": ["System"],
      "orphaned": false,
      "expected_users": ["NT AUTHORITY\\SYSTEM"],
      "instance_policy": "singleton",
      "expected_session": 0,
      "syswow64_ok": false,
      "severity_if_mismatch": "critical",
      "notes": "One persistent master instance whose parent is System (PID 4). Per-session children are transient and exit immediately.",
      "attack_techniques": ["T1036.005"]
    },
    {
      "name": "csrss.exe",
      "category": "core",
      "description": "Client/Server Runtime Subsystem. Win32 subsystem process.",
      "expected_paths": ["%SystemRoot%\\System32\\csrss.exe"],
      "path_on_disk": true,
      "expected_parents": ["smss.exe"],
      "orphaned": true,
      "expected_users": ["NT AUTHORITY\\SYSTEM"],
      "instance_policy": "one_per_session",
      "expected_session": null,
      "syswow64_ok": false,
      "severity_if_mismatch": "critical",
      "notes": "Normally two or more (session 0 and each interactive session). Parent smss.exe has exited, so it appears orphaned. Never has child processes in normal operation.",
      "attack_techniques": ["T1036.005"]
    },
    {
      "name": "wininit.exe",
      "category": "core",
      "description": "Windows Initialisation. Starts services.exe and lsass.exe.",
      "expected_paths": ["%SystemRoot%\\System32\\wininit.exe"],
      "path_on_disk": true,
      "expected_parents": ["smss.exe"],
      "orphaned": true,
      "expected_users": ["NT AUTHORITY\\SYSTEM"],
      "instance_policy": "singleton",
      "expected_session": 0,
      "syswow64_ok": false,
      "severity_if_mismatch": "critical",
      "notes": "Always session 0. Parent has exited so it appears orphaned.",
      "attack_techniques": ["T1036.005"]
    },
    {
      "name": "winlogon.exe",
      "category": "core",
      "description": "Handles interactive logon, Secure Attention Sequence, and profile loading.",
      "expected_paths": ["%SystemRoot%\\System32\\winlogon.exe"],
      "path_on_disk": true,
      "expected_parents": ["smss.exe"],
      "orphaned": true,
      "expected_users": ["NT AUTHORITY\\SYSTEM"],
      "instance_policy": "one_per_session",
      "syswow64_ok": false,
      "severity_if_mismatch": "critical",
      "notes": "Common target for Image File Execution Options and shell hijacking. Spawns userinit.exe and dwm.exe.",
      "attack_techniques": ["T1036.005", "T1546.008"]
    },
    {
      "name": "services.exe",
      "category": "core",
      "description": "Service Control Manager. Parent of most Windows services.",
      "expected_paths": ["%SystemRoot%\\System32\\services.exe"],
      "path_on_disk": true,
      "expected_parents": ["wininit.exe"],
      "orphaned": false,
      "expected_users": ["NT AUTHORITY\\SYSTEM"],
      "instance_policy": "singleton",
      "expected_session": 0,
      "syswow64_ok": false,
      "severity_if_mismatch": "critical",
      "notes": "Exactly one, parented by wininit.exe. Anything else is compromise.",
      "attack_techniques": ["T1036.005", "T1543.003"]
    },
    {
      "name": "lsass.exe",
      "category": "core",
      "description": "Local Security Authority Subsystem. Holds credential material in memory.",
      "expected_paths": ["%SystemRoot%\\System32\\lsass.exe"],
      "path_on_disk": true,
      "expected_parents": ["wininit.exe"],
      "orphaned": false,
      "expected_users": ["NT AUTHORITY\\SYSTEM"],
      "instance_policy": "singleton",
      "expected_session": 0,
      "syswow64_ok": false,
      "severity_if_mismatch": "critical",
      "notes": "Highest-value target on the box. Exactly ONE instance, parented by wininit.exe, and it should have NO child processes. Watch for lookalikes: lsass.exe in a non-System32 path, lsas.exe, lsassa.exe, isass.exe (capital i for l). Any non-standard process opening a handle to lsass is likely credential dumping.",
      "attack_techniques": ["T1036.005", "T1003.001"]
    },
    {
      "name": "lsm.exe",
      "category": "core",
      "description": "Local Session Manager. Windows 7 / Server 2008 R2 and earlier only.",
      "expected_paths": ["%SystemRoot%\\System32\\lsm.exe"],
      "path_on_disk": true,
      "expected_parents": ["wininit.exe"],
      "orphaned": false,
      "expected_users": ["NT AUTHORITY\\SYSTEM"],
      "instance_policy": "singleton",
      "expected_session": 0,
      "syswow64_ok": false,
      "severity_if_mismatch": "critical",
      "windows_versions": "<=6.1",
      "notes": "On Windows 8 and later this became a service DLL (lsm.dll) hosted in svchost.exe. On Windows 10/11 a running lsm.exe is suspicious by definition.",
      "attack_techniques": ["T1036.005"]
    },
    {
      "name": "svchost.exe",
      "category": "core",
      "description": "Generic host process for Windows services loaded from DLLs.",
      "expected_paths": ["%SystemRoot%\\System32\\svchost.exe"],
      "path_on_disk": true,
      "expected_parents": ["services.exe"],
      "orphaned": false,
      "expected_users": [
        "NT AUTHORITY\\SYSTEM",
        "NT AUTHORITY\\LOCAL SERVICE",
        "NT AUTHORITY\\NETWORK SERVICE"
      ],
      "instance_policy": "multiple",
      "syswow64_ok": false,
      "severity_if_mismatch": "critical",
      "expected_cmdline_contains": ["-k"],
      "notes": "The most impersonated process on Windows. Dozens of instances is normal, but EVERY legitimate one is parented by services.exe and carries a -k argument. An svchost.exe without -k, parented by anything other than services.exe, or running from a user-writable directory is a classic masquerade. Watch for scvhost.exe / svch0st.exe / svhost.exe.",
      "attack_techniques": ["T1036.005", "T1055"]
    },
    {
      "name": "explorer.exe",
      "category": "core",
      "description": "Windows shell - desktop, taskbar, file browser.",
      "expected_paths": ["%SystemRoot%\\explorer.exe"],
      "path_on_disk": true,
      "expected_parents": ["userinit.exe"],
      "orphaned": true,
      "expected_users": ["<interactive user>"],
      "instance_policy": "one_per_user",
      "syswow64_ok": false,
      "severity_if_mismatch": "critical",
      "notes": "NOTE THE PATH - it lives in %SystemRoot% directly, NOT System32. An explorer.exe in System32 is malicious. Parent userinit.exe exits immediately so explorer normally appears orphaned. Frequent process-injection target.",
      "attack_techniques": ["T1036.005", "T1055"]
    },
    {
      "name": "userinit.exe",
      "category": "core",
      "description": "Runs logon scripts and launches the shell, then exits.",
      "expected_paths": ["%SystemRoot%\\System32\\userinit.exe"],
      "path_on_disk": true,
      "expected_parents": ["winlogon.exe"],
      "orphaned": false,
      "expected_users": ["<interactive user>"],
      "instance_policy": "transient",
      "syswow64_ok": true,
      "severity_if_mismatch": "high",
      "notes": "Exits seconds after logon, so a long-running userinit.exe is suspicious. The Userinit registry value is a well-known persistence point.",
      "attack_techniques": ["T1036.005", "T1547.004"]
    },
    {
      "name": "dwm.exe",
      "category": "core",
      "description": "Desktop Window Manager - compositing and visual effects.",
      "expected_paths": ["%SystemRoot%\\System32\\dwm.exe"],
      "path_on_disk": true,
      "expected_parents": ["winlogon.exe"],
      "orphaned": false,
      "expected_users": ["Window Manager\\DWM-1", "Window Manager\\DWM-2"],
      "instance_policy": "one_per_session",
      "syswow64_ok": false,
      "severity_if_mismatch": "high",
      "notes": "Runs under dedicated DWM-n virtual accounts on Windows 10/11.",
      "attack_techniques": ["T1036.005"]
    },
    {
      "name": "conhost.exe",
      "category": "core",
      "description": "Console Window Host - provides the console UI for CLI processes.",
