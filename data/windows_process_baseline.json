  "suspicious_path_patterns": {
    "description": "Directories from which NO baseline system process should ever execute. A known system process name running from any of these is a masquerading indicator regardless of other attributes.",
    "patterns": [
      "%TEMP%\\*",
      "%TMP%\\*",
      "%APPDATA%\\*",
      "%LOCALAPPDATA%\\Temp\\*",
      "%USERPROFILE%\\Downloads\\*",
      "%USERPROFILE%\\Desktop\\*",
      "%PUBLIC%\\*",
      "%SystemDrive%\\Users\\Public\\*",
      "%SystemDrive%\\PerfLogs\\*",
      "%SystemDrive%\\Intel\\*",
      "%SystemDrive%\\Windows\\Temp\\*",
      "%SystemRoot%\\Tasks\\*",
      "%SystemRoot%\\Debug\\*",
      "%SystemRoot%\\addins\\*",
      "%SystemRoot%\\repair\\*",
      "%SystemRoot%\\System32\\Tasks\\*",
      "%ProgramData%\\*"
    ],
    "note": "%ProgramData% has legitimate uses (Defender lives there) - treat it as medium confidence and exempt entries whose baseline expected_paths already point inside it."
  },

  "homoglyph_watchlist": {
    "description": "Names visually confusable with baseline processes. An observed process whose name is not an exact baseline match but is within a small edit distance of one, or matches an entry here, should be flagged as a likely typosquat.",
    "examples": {
      "svchost.exe": ["scvhost.exe", "svch0st.exe", "svhost.exe", "svchosts.exe", "svchost32.exe"],
      "lsass.exe": ["lsas.exe", "lsassa.exe", "isass.exe", "l5ass.exe", "lssass.exe"],
      "csrss.exe": ["csrsss.exe", "csrs.exe", "crss.exe"],
      "explorer.exe": ["explore.exe", "expl0rer.exe", "iexplorer.exe", "explorer32.exe"],
      "services.exe": ["service.exe", "servicess.exe", "serv1ces.exe"],
      "winlogon.exe": ["winlogin.exe", "winl0gon.exe", "wlnlogon.exe"],
      "rundll32.exe": ["rundl132.exe", "rundll32x.exe", "run32dll.exe"],
      "taskhostw.exe": ["taskhostx.exe", "taskh0stw.exe"],
      "conhost.exe": ["c0nhost.exe", "conhosts.exe"]
    },
    "detection_hint": "Levenshtein distance of 1-2 against any baseline name, or any name differing only by digit-for-letter substitution (0/o, 1/l, 5/s), warrants a flag."
  }
